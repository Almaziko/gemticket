# Flask
SECRET_KEY=change-me-to-a-random-string
PORT=5000

# Fernet key for reversible password/SMTP-password encryption.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Пароль первого (супер)админа. Используется только при первом старте,
# когда в базе ещё нет ни одного админа.
ADMIN_PASSWORD=change-me

# Базовый URL приложения, используется в ссылках в письмах
BASE_URL=http://localhost:5000

# Путь к файлу SQLite
DATABASE=instance/gemticket.db

# Директория для вложений (файлы/картинки)
UPLOAD_DIR=uploads
